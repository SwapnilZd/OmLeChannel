<clickhouse>
    <!-- Langfuse does not read these ClickHouse diagnostic tables. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <latency_log remove="1"/>

    <!-- Retain the smaller diagnostic tables for short-term troubleshooting. -->
    <query_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </part_log>
    <error_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </error_log>

    <!-- Bound ordinary on-disk server logs to approximately 300 MB. -->
    <logger>
        <size>100M</size>
        <count>3</count>
    </logger>
</clickhouse>
