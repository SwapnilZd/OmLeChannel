<section class="slide-comparison" data-screen-id="{{ s.screen_id }}">
  <h2>{{ s.heading }}</h2>
  <div class="table-wrap"><table><thead><tr><th scope="col">Dimension</th>{% for column in s.columns %}<th scope="col">{{ column }}</th>{% endfor %}</tr></thead>
  <tbody>{% for row in s.rows %}<tr><th scope="row">{{ row.label }}</th>{% for value in row['values'] %}<td>{{ value }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
</section>
