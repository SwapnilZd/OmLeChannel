<section class="slide-flip-cards" data-screen-id="{{ s.screen_id }}">
  <div class="slide-header">
    <h2>{{ s.section_label }}</h2>
    <p class="instruction">{{ s.instruction }}</p>
  </div>
  <div class="flip-grid flip-grid-{{ s.cards | length }}" data-item-count="{{ s.cards | length }}">
    {% for c in s.cards %}
    <div class="flip-card" tabindex="0" role="button"
         aria-label="Flip: {{ c.front_label }}"
         onclick="this.classList.toggle('flipped')"
         onkeydown="if(event.key==='Enter'||event.key===' ')this.classList.toggle('flipped')">
      <div class="flip-inner">
        <div class="flip-front">
          <h3>{{ c.front_label }}</h3>
          <p>{{ c.front_teaser }}</p>
          <span class="flip-hint">Click to reveal ↩</span>
        </div>
        <div class="flip-back">
          <h3>{{ c.front_label }}</h3>
          <p class="back-def">{{ c.back_definition }}</p>
          <ul>
            {% for ex in c.back_examples %}
            <li>{{ ex }}</li>
            {% endfor %}
          </ul>
          <p class="safeguard">{{ c.back_safeguard }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
