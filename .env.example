# Copy to .env and fill in the API keys — never commit .env

# ── Platform ───────────────────────────────────────────────────────────────────
# linux/arm64 for Apple Silicon, linux/amd64 for Intel/CI
DOCKER_PLATFORM=linux/arm64

# ── API Keys (fill these in) ───────────────────────────────────────────────────
# OpenAI — provider credential used only by the LiteLLM proxy
OPENAI_API_KEY=

# ── LiteLLM proxy ─────────────────────────────────────────────────────────────
LITELLM_PORT=4000
LITE_LLM_BASE_URL=http://litellm:4000
# Change LITELLM_MASTER_KEY and LITE_LLM_API_KEY to the same strong secret value
LITELLM_MASTER_KEY=sk-change-me
LITE_LLM_API_KEY=sk-change-me
LITELLM_BUDGET_DURATION=30d
LITELLM_SALT_KEY=change-me
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# ── Langfuse observability ────────────────────────────────────────────────────
# Start the local UI with: docker compose --profile observability up -d
# UI: http://localhost:3000
LANGFUSE_PORT=3000
LANGFUSE_URL=http://localhost:3000
LANGFUSE_OTEL_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@local.invalid
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=change-me
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
# Must be exactly 64 hexadecimal characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_SALT=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_S3_BUCKET=langfuse

# ── LiteLLM Postgres ──────────────────────────────────────────────────────────
POSTGRES_DB=litellm
POSTGRES_USER=litellm
# Change POSTGRES_PASSWORD and update it in DATABASE_URL below to match
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://litellm:change-me@litellm-postgres:5432/litellm

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# Maximum source-content tokens sent in one model or embedding request.
SOURCE_CONTENT_TRANCHE_TOKEN_LIMIT=15000
SOURCE_CONTENT_REQUEST_TOKEN_LIMIT=100000

# ── LiteLLM provider credentials (Vertex AI / Gemini TTS) ─────────────────────
# These are consumed by the LiteLLM proxy, not individual application services.
# Google Cloud (ADC)
# Run: gcloud auth application-default login
# Find your project ID: gcloud config get-value project
# Location: us-central1 works for most Gemini models; check your org policy if unsure
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ── Ingestion API ─────────────────────────────────────────────────────────────
API_PORT=8000
API_URL=http://api:8000
# Browser entry point. The gateway keeps commissioning traffic on the same
# origin so VPN clients do not need direct access to port 8010.
WEB_PORT=80

# Object storage backend: minio (local dev) or gcs (GCP production)
STORAGE_BACKEND=minio

# MinIO — local dev S3-compatible storage
# Console UI at http://localhost:9001 (login with these credentials)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rlos
# Generated courses, media, planning artifacts, and provider checkpoints
ARTIFACT_STORE_BACKEND=minio
MINIO_ARTIFACT_BUCKET=workflow-artifacts

# GCS — set these when STORAGE_BACKEND=gcs
# Ensure ADC is configured: gcloud auth application-default login
GCS_BUCKET=

# ── Phase 6: Persistent workflow execution ────────────────────────────────────
# Change WORKFLOW_POSTGRES_PASSWORD before running in any shared environment.
# The default is intentionally weak — it is only used when no .env is present.
WORKFLOW_POSTGRES_PASSWORD=change-me

# Browser origins allowed when calling the commissioning API directly. Normal
# UI traffic uses the same-origin gateway configured by WEB_PORT. On a server,
# replace the local hosts with the gateway's public origin.
COMMISSIONING_UI_ORIGINS=http://localhost,http://127.0.0.1

# Lightweight shared login for the VPN-hosted POC. Generate the signing secret
# with: openssl rand -hex 32. Set COOKIE_SECURE=true only when serving over HTTPS.
POC_AUTH_ENABLED=true
POC_AUTH_PASSWORD=omnichannel
POC_AUTH_SECRET=change-me
POC_AUTH_COOKIE_SECURE=false

# Port for the learning workflow API (separate from the existing RLO ingestion API at 8000)
WORKFLOW_API_PORT=8080

# Worker poll interval in seconds (1s is fine for local dev)
WORKER_POLL_INTERVAL_SECONDS=1

# ── Learning pipeline planner (assemble-course, plan-modality, plan-workflow) ──
# Set PIPELINE_MODE=real to use the shared LiteLLM connection above.
PIPELINE_MODE=reference

# ── Phase 7: Real speech synthesis (real-tools profile only) ──────────────────
# These are only read by workflow-worker-real (EXECUTOR_MODE=real).
# The default fake worker never reads them.
# Point LITE_LLM_BASE_URL at the one LiteLLM proxy used by every model call.
EXECUTOR_MODE=fake
# LITE_LLM_BASE_URL and LITE_LLM_API_KEY are already set above for the pipeline.
# Reuse those values or override here for the real worker.

# Voice mapping for speaker roles
PODCAST_HOST_VOICE=Aoede
PODCAST_EXPERT_VOICE=Charon

# TTS pricing assumptions (Google Gemini TTS defaults)
TTS_INPUT_COST_PER_TOKEN=0.000001
TTS_OUTPUT_COST_PER_TOKEN=0.00002
